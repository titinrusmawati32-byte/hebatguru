/* ---- Import siswa (CSV / Excel) ---- */
const IMP_ALIAS = {
  nis: ['nis', 'nomorinduk', 'nomorindukkesiswaan', 'noinduk'], nisn: ['nisn'],
  nama: ['nama', 'namasiswa', 'namalengkap', 'namapesertadidik'], jk: ['jk', 'jeniskelamin', 'lp', 'gender', 'kelamin'],
  tempat_lahir: ['tempatlahir', 'tempat', 'tmplahir'], tgl_lahir: ['tgllahir', 'tanggallahir', 'tanggal', 'ttl'],
  kelas: ['kelas', 'rombel', 'namakelas'], nama_ortu: ['namaortu', 'namaorangtua', 'orangtua', 'namawali', 'ayah', 'namaayah'],
  no_hp_ortu: ['nohportu', 'nohp', 'hp', 'telepon', 'notelp', 'nowa', 'nohpwa'], alamat: ['alamat'],
  bimbingan_wali: ['bimbinganwali', 'bimbingan', 'guruwali', 'walibimbingan']
};
const normH = h => String(h || '').toLowerCase().replace(/[^a-z0-9]/g, '');
function toDateStr(v) {
  if (v === '' || v == null) return null;
  if (typeof v === 'number' && v > 1000) { const d = new Date(Math.round((v - 25569) * 86400000)); return `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}`; }
  const s = String(v).trim(); let m = s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
  if (m) return `${m[1]}-${pad(m[2])}-${pad(m[3])}`;
  m = s.match(/^(\d{1,2})[-\/.](\d{1,2})[-\/.](\d{4})$/);
  return m ? `${m[3]}-${pad(m[2])}-${pad(m[1])}` : null;
}
function buildImport(mx) {
  if (mx.length < 2) throw new Error('File kosong atau tidak memiliki baris data');
  const head = mx[0].map(normH), col = {};
  for (const k in IMP_ALIAS) { const i = head.findIndex(h => IMP_ALIAS[k].includes(h)); if (i >= 0) col[k] = i; }
  if (col.nama == null) throw new Error('Kolom "nama" tidak ditemukan. Unduh dan gunakan template.');
  const raw = (r, k) => col[k] == null ? '' : (r[col[k]] ?? ''), g = (r, k) => String(raw(r, k)).trim();
  const rows = [], bad = [];
  mx.slice(1).forEach((r, i) => {
    const nama = g(r, 'nama'); if (!nama) { bad.push(i + 2); return; }
    rows.push({ nis: g(r, 'nis') || null, nisn: g(r, 'nisn') || null, nama, jk: /^(p|w)/i.test(g(r, 'jk')) ? 'P' : 'L', tempat_lahir: g(r, 'tempat_lahir') || null, tgl_lahir: toDateStr(raw(r, 'tgl_lahir')), kelasNama: g(r, 'kelas'), nama_ortu: g(r, 'nama_ortu') || null, no_hp_ortu: g(r, 'no_hp_ortu') || null, alamat: g(r, 'alamat') || null, bimbingan_wali: /^(ya|y|1|true|wali|v|x|ok)$/i.test(g(r, 'bimbingan_wali')), aktif: true });
  });
  return { rows, bad };
}
function loadXLSX() {
  return new Promise((res, rej) => {
    if (window.XLSX) return res(window.XLSX);
    const s = document.createElement('script'); s.src = 'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js';
    s.onload = () => res(window.XLSX); s.onerror = () => rej(new Error('Gagal memuat pustaka Excel. Simpan file sebagai CSV lalu coba lagi.'));
    document.head.appendChild(s);
  });
}
