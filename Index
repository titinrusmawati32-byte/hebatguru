/* sesi mengajar (gabungan jam berurutan) untuk satu hari */
function sessionsOf(hi, jur = [], abs = []) {
  const by = new Map();
  D.jadwal.filter(j => j.hari === hi).sort((a, b) => a.jam_ke - b.jam_ke).forEach(j => {
    const key = j.kelas_id + ':' + j.mapel_id, arr = by.get(key) || []; by.set(key, arr);
    const l = arr[arr.length - 1];
    if (l && j.jam_ke === l.jam_to + 1) l.jam_to = j.jam_ke;
    else arr.push({ kelas_id: j.kelas_id, mapel_id: j.mapel_id, ruang: j.ruang, jam_from: j.jam_ke, jam_to: j.jam_ke });
  });
  const ses = [].concat(...by.values()).sort((a, b) => a.jam_from - b.jam_from || String((K(a.kelas_id) || {}).nama).localeCompare(String((K(b.kelas_id) || {}).nama), 'id'));
  ses.forEach(s => {
    s.key = `${s.kelas_id}:${s.mapel_id}:${s.jam_from}`;
    s.guru_id = guruIdOf(s.mapel_id, s.kelas_id);
    s.jurnal = jur.some(x => x.kelas_id === s.kelas_id && x.mapel_id === s.mapel_id);
    s.absen = abs.some(x => x.kelas_id === s.kelas_id && x.mapel_id === s.mapel_id);
    s.mulai = (jamOf(s.jam_from) || {}).mulai; s.selesai = (jamOf(s.jam_to) || {}).selesai;
    s.jamTxt = s.jam_from === s.jam_to ? `${s.jam_from}` : `${s.jam_from}-${s.jam_to}`;
  });
  return ses;
}

