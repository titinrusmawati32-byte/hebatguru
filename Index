<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#F8775F">
<!-- PWA: manifest.json sebagai Data URI (disesuaikan ulang oleh JS agar start_url benar) -->
<link rel="manifest" id="ag-manifest" href="data:application/manifest+json;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<title>GuruKu - Administrasi Guru</title>
<style id="ag-style">
#ag{
  --ink:#26223F;--text:#6E6A80;--muted:#B1AEBD;--line:#EEEDF3;
  --coral1:#FFA88A;--coral2:#F8775F;--vio1:#8C7CF0;--vio2:#6D5BE0;
  --pink1:#FF8DAA;--pink2:#F25C85;--ora1:#FFC19A;--ora2:#FF9F6E;--blue1:#8DB8FF;--blue2:#5B93F5;
  --ok:#34C38F;--warn:#F6B94C;--bad:#F2617A;--glass:rgba(255,255,255,.74);
  position:fixed;inset:0;z-index:2147483000;overflow:hidden;
  font-family:'Plus Jakarta Sans',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;font-size:14px;line-height:1.5;color:var(--text);
  background:radial-gradient(900px 600px at 8% 0%,#fff0e8 0%,transparent 60%),radial-gradient(800px 600px at 100% 100%,#f6bfae 0%,transparent 62%),linear-gradient(135deg,#FDE3D8,#F9CDBE);
  -webkit-font-smoothing:antialiased;
  *{box-sizing:border-box}
  h1,h2,h3,h4,p{margin:0}
  button,input,select,textarea{font:inherit;color:inherit}
  button{cursor:pointer;border:0;background:none;padding:0}
  svg{flex:none}
  .sp{flex:1}
  .hide{display:none!important}

  /* ===== Shell ===== */
  .shell{position:absolute;inset:22px;border-radius:32px;background:var(--glass);backdrop-filter:blur(26px) saturate(1.4);-webkit-backdrop-filter:blur(26px) saturate(1.4);box-shadow:0 30px 80px rgba(210,110,80,.22),inset 0 0 0 1px rgba(255,255,255,.7);display:grid;grid-template-columns:232px minmax(0,1fr);overflow:hidden}
  .side{padding:22px 16px;display:flex;flex-direction:column;gap:16px;background:rgba(248,248,250,.55);border-right:1px solid var(--line);overflow-y:auto}
  .brand{display:flex;align-items:center;gap:10px;padding:0 6px;font-size:20px;color:var(--ink)}
  .brand b{font-weight:800;letter-spacing:-.02em}
  .logo{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,var(--vio1),var(--vio2));box-shadow:0 8px 18px rgba(109,91,224,.35)}
  .nav{display:flex;flex-direction:column;gap:4px}
  .nav-i{display:flex;align-items:center;gap:12px;padding:11px 14px;border-radius:16px;color:var(--text);font-weight:600;font-size:13.5px;text-align:left;width:100%;transition:.2s}
  .nav-i:hover{background:rgba(255,255,255,.85);color:var(--ink)}
  .nav-i.on{background:linear-gradient(135deg,var(--coral1),var(--coral2));color:#fff;box-shadow:0 10px 22px rgba(248,119,95,.32)}
  .sidecard{margin-top:auto;background:#fff;border-radius:24px;padding:18px 14px;display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center;box-shadow:0 8px 30px rgba(120,100,160,.08)}
  .sidecard b{color:var(--ink);font-size:14px}
  .sidecard small{color:var(--muted);font-size:12px;margin-bottom:8px}
  .trophy{width:54px;height:54px;border-radius:50%;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,var(--vio1),var(--vio2));box-shadow:0 10px 22px rgba(109,91,224,.35);margin-bottom:6px}
  .logout{display:flex;align-items:center;gap:12px;padding:8px 10px;border-radius:18px;font-weight:600;color:var(--ink);transition:.2s}
  .logout:hover{background:rgba(255,255,255,.85)}
  .lo-ic{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,var(--coral1),var(--coral2));box-shadow:0 8px 18px rgba(248,119,95,.35)}
  .main{display:flex;flex-direction:column;min-width:0;min-height:0}
  .top{display:flex;align-items:center;gap:16px;padding:22px 28px 14px}
  .mbrand{display:none;align-items:center;gap:8px;font-weight:800;color:var(--ink);font-size:17px}
  .mbrand .logo{width:32px;height:32px}
  .search{flex:1;max-width:560px;display:flex;align-items:center;gap:10px;background:#fff;border-radius:20px;padding:0 18px;height:50px;color:var(--muted);box-shadow:0 8px 30px rgba(120,100,160,.07)}
  .search input{border:0;outline:0;background:none;width:100%;font-size:13.5px;color:var(--ink)}
  .top-r{margin-left:auto;display:flex;align-items:center;gap:8px}
  .iconbtn{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;color:var(--ink);position:relative;transition:.2s}
  .iconbtn:hover{background:rgba(255,255,255,.9)}
  .dot{position:absolute;top:8px;right:9px;width:9px;height:9px;border-radius:50%;background:var(--vio1);border:2px solid #fff;display:none}
  .avatar-btn{width:40px;height:40px;border-radius:50%;font-weight:800;color:#fff;font-size:13px;background:linear-gradient(135deg,var(--blue1),var(--vio2));box-shadow:0 8px 18px rgba(109,91,224,.3)}
  .content{flex:1;overflow:auto;padding:4px 28px 32px;scroll-behavior:smooth}
  .loading{display:grid;place-items:center;height:260px}
  .spin{width:34px;height:34px;border-radius:50%;border:4px solid var(--line);border-top-color:var(--coral2);animation:spin .8s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}
  @keyframes pop{from{opacity:0;transform:translateY(10px) scale(.98)}to{opacity:1;transform:none}}
  .view{animation:pop .3s ease}

  /* ===== Page head ===== */
  .phead{display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap;margin:6px 0 18px}
  .phead h1{font-size:30px;font-weight:800;color:var(--ink);letter-spacing:-.02em;line-height:1.2}
  .phead h1 small{font-size:15px;font-weight:500;color:var(--text);letter-spacing:0;margin-left:8px}
  .acts{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
  .sec-h{display:flex;align-items:center;gap:10px;margin:22px 0 12px}
  .sec-h h2{font-size:20px;font-weight:500;color:var(--ink)}
  .sec-h h2 b{font-weight:800}

  /* ===== Buttons & chips ===== */
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 18px;border-radius:999px;font-weight:700;font-size:13px;transition:.2s;white-space:nowrap;background:#fff;color:var(--ink);box-shadow:0 4px 14px rgba(120,100,160,.1)}
  .btn:hover{transform:translateY(-2px)}
  .btn:active{transform:scale(.97)}
  .btn:disabled{opacity:.55;pointer-events:none}
  .btn.pri{background:linear-gradient(135deg,var(--coral1),var(--coral2));color:#fff;box-shadow:0 10px 22px rgba(248,119,95,.3)}
  .btn.vio{background:linear-gradient(135deg,var(--vio1),var(--vio2));color:#fff;box-shadow:0 10px 22px rgba(109,91,224,.3)}
  .btn.bad{background:#fff0f3;color:var(--bad);box-shadow:none}
  .btn.ghost{background:rgba(255,255,255,.7);box-shadow:none;border:1px solid var(--line)}
  .btn.wht{background:#fff;color:var(--ink);box-shadow:0 8px 18px rgba(0,0,0,.12)}
  .btn.sm{padding:7px 13px;font-size:12px}
  .btn.ic{padding:8px;width:34px;height:34px}
  .ib{width:32px;height:32px;border-radius:50%;display:inline-grid;place-items:center;color:var(--text);transition:.2s}
  .ib:hover{background:#fff;color:var(--ink)}
  .ib.bad:hover{background:#fff0f3;color:var(--bad)}
  .badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:999px;font-size:11.5px;font-weight:700;background:#f1f0f6;color:var(--text);white-space:nowrap}
  .b-ok{background:#e4f8f0;color:#1f9a6d}.b-warn{background:#fff5df;color:#b9811a}.b-bad{background:#ffe9ee;color:#d8435f}.b-vio{background:#eeeafe;color:#6D5BE0}.b-ora{background:#ffeede;color:#e0722f}.b-pink{background:#ffe6ee;color:#e0467a}
  .tabs{display:flex;gap:6px;flex-wrap:wrap;background:rgba(255,255,255,.6);padding:5px;border-radius:999px;width:fit-content;max-width:100%;overflow:auto;margin-bottom:16px}
  .tab{padding:8px 16px;border-radius:999px;font-weight:700;font-size:13px;color:var(--text);white-space:nowrap;transition:.2s}
  .tab:hover{color:var(--ink)}
  .tab.on{background:linear-gradient(135deg,var(--coral1),var(--coral2));color:#fff;box-shadow:0 8px 18px rgba(248,119,95,.3)}
  .tab em{font-style:normal;opacity:.8;margin-left:4px}

  /* ===== Cards, tables ===== */
  .card{background:#fff;border-radius:24px;padding:20px;box-shadow:0 8px 30px rgba(120,100,160,.08)}
  .card.flat{box-shadow:none;border:1px solid var(--line)}
  .toolbar{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:14px}
  .inp,.fld input,.fld select,.fld textarea{width:100%;padding:10px 14px;border:1.5px solid var(--line);border-radius:14px;background:#fff;outline:none;transition:.2s;color:var(--ink);font-size:13.5px}
  .inp:focus,.fld input:focus,.fld select:focus,.fld textarea:focus{border-color:var(--vio1);box-shadow:0 0 0 4px rgba(140,124,240,.15)}
  .inp:disabled,.fld input:disabled,.fld select:disabled,.fld textarea:disabled{background:#f7f7fa;color:var(--text)}
  .toolbar .inp{width:auto;min-width:150px;max-width:260px}
  .tbl-wrap{overflow:auto;border-radius:18px}
  .tbl{width:100%;border-collapse:collapse;font-size:13px}
  .tbl th{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);text-align:left;padding:10px 12px;font-weight:700;white-space:nowrap;border-bottom:1px solid var(--line);background:#fff;position:sticky;top:0;z-index:1}
  .tbl td{padding:10px 12px;border-bottom:1px solid var(--line);vertical-align:middle;color:var(--ink)}
  .tbl tr:last-child td{border-bottom:0}
  .tbl tbody tr:hover td{background:#fbfaff}
  .tbl .r{text-align:right;white-space:nowrap}.tbl .c{text-align:center}
  .tbl td.muted,.muted{color:var(--muted)}
  .who{display:flex;align-items:center;gap:10px;min-width:150px}
  .who b{display:block;color:var(--ink);font-weight:700;line-height:1.25}
  .who small{color:var(--muted);font-size:11.5px}
  .avatar{width:34px;height:34px;border-radius:50%;display:grid;place-items:center;color:#fff;font-weight:800;font-size:12px;flex:none;border:2px solid #fff}
  .stack{display:flex}.stack .avatar{margin-left:-8px}.stack .avatar:first-child{margin-left:0}
  .g-vio{background:linear-gradient(160deg,#B8A6F5,#7E6BE8)}.g-pink{background:linear-gradient(160deg,#FF8FA8,#F0647F)}.g-ora{background:linear-gradient(160deg,#FFB58A,#FF9B6A)}.g-blue{background:linear-gradient(160deg,#8DB8FF,#5B93F5)}.g-coral{background:linear-gradient(160deg,#FFA88A,#F8775F)}
  .empty{display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center;padding:42px 20px;color:var(--text)}
  .empty .ei{width:64px;height:64px;border-radius:50%;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,var(--vio1),var(--vio2));box-shadow:0 12px 26px rgba(109,91,224,.3)}
  .empty b{color:var(--ink);font-size:15px}
  .bulk{display:flex;gap:8px;flex-wrap:wrap;align-items:center;background:#eeeafe;border-radius:16px;padding:10px 14px;margin-bottom:12px;color:#6D5BE0;font-weight:700}
  .pager{display:flex;align-items:center;gap:10px;justify-content:flex-end;padding-top:12px;font-size:12.5px;color:var(--text)}
  input[type=checkbox].cb{width:17px;height:17px;accent-color:var(--coral2);cursor:pointer}

  /* ===== Dashboard ===== */
  .dash{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:24px;align-items:start}
  .stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
  .stat{background:#fff;border-radius:22px;padding:14px;display:flex;align-items:center;gap:12px;box-shadow:0 8px 30px rgba(120,100,160,.07)}
  .bub{width:46px;height:46px;border-radius:50%;display:grid;place-items:center;color:#fff;flex:none;box-shadow:0 8px 18px rgba(0,0,0,.14),inset 0 -4px 8px rgba(0,0,0,.08)}
  .stat b{display:block;font-size:20px;color:var(--ink);line-height:1.1;font-weight:800}
  .stat small{color:var(--text);font-size:11.5px}
  .qa{display:grid;grid-template-columns:repeat(3,1fr) 120px;gap:14px}
  .qcard{position:relative;overflow:hidden;border-radius:26px;padding:16px;color:#fff;display:flex;flex-direction:column;gap:2px;min-height:158px;box-shadow:0 14px 28px rgba(120,100,160,.2)}
  .qcard:after{content:"";position:absolute;right:-26px;top:-26px;width:110px;height:110px;border-radius:50%;background:rgba(255,255,255,.18)}
  .qcard .qi{width:38px;height:38px;border-radius:12px;background:#fff;display:grid;place-items:center;margin-bottom:12px;position:relative;z-index:1}
  .qcard.g-vio .qi{color:#7E6BE8}.qcard.g-pink .qi{color:#F0647F}.qcard.g-ora .qi{color:#FF9B6A}
  .qcard b{font-size:17px;font-weight:800;position:relative;z-index:1}
  .qcard small{opacity:.85;font-size:12px;margin-bottom:auto;position:relative;z-index:1}
  .qcard .btn{margin-top:10px;position:relative;z-index:1}
  .qmore{border-radius:26px;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;color:var(--ink);font-weight:700;box-shadow:0 8px 30px rgba(120,100,160,.08);cursor:pointer;transition:.2s}
  .qmore:hover{transform:translateY(-3px)}
  .qmore .mb{width:40px;height:40px;border-radius:50%;background:#2c2842;color:#fff;display:grid;place-items:center}
  .dcard{background:rgba(255,255,255,.8);border-radius:28px;padding:18px;box-shadow:0 8px 30px rgba(120,100,160,.07)}
  .strip{display:flex;gap:6px;overflow:auto;background:#f6f5fa;border-radius:20px;padding:8px;margin-bottom:14px}
  .day{flex:1;min-width:48px;border-radius:14px;padding:8px 4px;display:flex;flex-direction:column;align-items:center;transition:.2s;color:var(--ink)}
  .day b{font-size:14px;font-weight:800}.day small{font-size:10.5px;color:var(--muted)}
  .day:hover{background:#fff}
  .day.on{background:linear-gradient(135deg,var(--coral1),var(--coral2));color:#fff;box-shadow:0 8px 18px rgba(248,119,95,.3)}
  .day.on small{color:#fff;opacity:.85}
  .trow{display:grid;grid-template-columns:54px 1fr;gap:10px;align-items:center;padding:7px 0;border-bottom:1px dashed var(--line)}
  .trow:last-child{border-bottom:0}
  .tt{font-size:12px;font-weight:700;color:var(--muted)}
  .pill{display:inline-flex;align-items:center;gap:8px;padding:9px 16px;border-radius:999px;color:#fff;font-size:12.5px;font-weight:700;transition:.2s;box-shadow:0 8px 16px rgba(120,100,160,.2);text-align:left;overflow:hidden;white-space:nowrap}
  .pill small{opacity:.85;font-weight:500;overflow:hidden;text-overflow:ellipsis}
  .pill.sel{outline:3px solid rgba(38,34,63,.18);outline-offset:2px}
  .pill:hover{transform:translateY(-2px)}
  .c0{background:linear-gradient(90deg,#B7A8F7,#8C7CF0)}.c1{background:linear-gradient(90deg,#FFB59A,#F8775F)}.c2{background:linear-gradient(90deg,#FF9DB5,#F25C85)}.c3{background:linear-gradient(90deg,#FFD0A8,#FF9F6E)}
  .prog{display:flex;align-items:center;gap:12px;margin-top:12px}
  .prog .bar{flex:1;height:30px;border-radius:999px;background:#fff;border:2px solid var(--vio1);overflow:hidden;position:relative}
  .prog .bar i{position:absolute;inset:0 auto 0 0;background:linear-gradient(90deg,var(--vio1),var(--vio2));border-radius:999px}
  .prog .bar span{position:absolute;left:14px;top:0;line-height:26px;font-size:12px;font-weight:700;color:#fff;z-index:1}
  .prog b{color:var(--vio2);font-size:12.5px}
  .rpanel{background:rgba(247,247,250,.85);border-radius:28px;padding:22px;display:flex;flex-direction:column;gap:16px}
  .rpanel h2{font-size:22px;font-weight:500;color:var(--ink)}.rpanel h2 b{font-weight:800}
  .rpanel .desc{font-size:12px;color:var(--muted);margin-top:-8px}
  .irow{display:flex;align-items:center;gap:14px}
  .irow small{display:block;color:var(--muted);font-size:12px}
  .irow b{color:var(--ink);font-size:13.5px}

  /* ===== Forms & modal ===== */
  .frm{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .fld{display:flex;flex-direction:column;gap:6px}
  .fld.full{grid-column:1/-1}
  .fld>label{font-size:12px;font-weight:700;color:var(--ink)}
  .fld textarea{resize:vertical;min-height:70px}
  .sw{display:flex;align-items:center;gap:10px;cursor:pointer;font-size:13px;color:var(--ink);padding:8px 0}
  .sw input{width:18px;height:18px;accent-color:var(--coral2)}
  .modal-bg{position:absolute;inset:0;z-index:50;background:rgba(38,34,63,.38);backdrop-filter:blur(6px);display:grid;place-items:center;padding:18px;opacity:0;transition:.2s}
  .modal-bg.show{opacity:1}.modal-bg.top{z-index:80}
  .modal{background:#fff;border-radius:28px;width:min(560px,100%);max-height:calc(100% - 10px);display:flex;flex-direction:column;box-shadow:0 30px 80px rgba(38,34,63,.3);animation:pop .25s ease}
  .modal.wide{width:min(860px,100%)}.modal.sm{width:min(380px,100%)}
  .m-h{display:flex;align-items:center;padding:20px 22px 6px}
  .m-h h3{font-size:18px;color:var(--ink);font-weight:800;flex:1}
  .m-b{padding:12px 22px;overflow:auto}
  .m-f{display:flex;gap:8px;align-items:center;padding:12px 22px 20px}
  .conf-ic{width:54px;height:54px;border-radius:50%;background:#ffe9ee;color:var(--bad);display:grid;place-items:center;margin:8px auto 12px}
  .conf-t{text-align:center;color:var(--ink);font-weight:600}
  .note{background:#f6f5fa;border-radius:14px;padding:10px 14px;font-size:12.5px;margin-top:12px}
  .toasts,#toasts{position:absolute;right:20px;bottom:20px;z-index:99;display:flex;flex-direction:column;gap:8px;align-items:flex-end;pointer-events:none}
  .toast{display:flex;align-items:center;gap:10px;background:#26223F;color:#fff;padding:11px 16px;border-radius:16px;font-weight:600;font-size:13px;box-shadow:0 14px 30px rgba(0,0,0,.25);animation:pop .25s ease;transition:.3s;max-width:360px}
  .toast.bad{background:#d8435f}.toast.ok svg{color:#6ee7b7}.toast.out{opacity:0;transform:translateY(8px)}
  .pop{position:absolute;top:76px;right:26px;z-index:60;width:min(330px,calc(100% - 28px));background:#fff;border-radius:22px;padding:10px;box-shadow:0 24px 60px rgba(38,34,63,.25);animation:pop .2s ease}
  .pop h4{padding:8px 10px;color:var(--ink);font-size:14px}
  .pop-i{display:flex;gap:10px;align-items:center;padding:10px;border-radius:14px;width:100%;text-align:left;color:var(--ink);font-weight:600;font-size:13px}
  .pop-i:hover{background:#f6f5fa}
  .pop .empty{padding:20px}

  /* ===== Login ===== */
  .login{position:absolute;inset:0;display:grid;place-items:center;padding:18px;overflow:auto}
  .lcard{width:min(420px,100%);background:var(--glass);backdrop-filter:blur(26px);-webkit-backdrop-filter:blur(26px);border-radius:32px;padding:34px 30px;box-shadow:0 30px 80px rgba(210,110,80,.25),inset 0 0 0 1px rgba(255,255,255,.8);display:flex;flex-direction:column;gap:16px}
  .lcard .brand{justify-content:center;font-size:26px}
  .lcard .logo{width:48px;height:48px}
  .lcard h2{text-align:center;color:var(--ink);font-size:18px;font-weight:700}
  .lcard .sub{text-align:center;font-size:13px;margin-top:-10px}
  .lcard .tabs{width:100%;margin:0}.lcard .tabs .tab{flex:1;text-align:center}
  .lcard form{display:flex;flex-direction:column;gap:14px}

  /* ===== Jadwal ===== */
  .jgrid table{width:100%;border-collapse:separate;border-spacing:6px;table-layout:fixed}
  .jgrid th{font-size:12px;font-weight:800;color:var(--ink);padding:8px;background:#f6f5fa;border-radius:14px}
  .jgrid th.today{background:linear-gradient(135deg,var(--coral1),var(--coral2));color:#fff}
  .jgrid td{vertical-align:top;height:74px;padding:0}
  .jgrid td.jt{width:78px;background:none;text-align:center;vertical-align:middle}
  .jt b{display:block;color:var(--ink);font-size:15px}.jt small{font-size:10.5px;color:var(--muted)}
  .slot{width:100%;height:100%;min-height:66px;border-radius:16px;color:#fff;padding:8px 10px;text-align:left;display:flex;flex-direction:column;gap:1px;transition:.2s;box-shadow:0 8px 16px rgba(120,100,160,.18)}
  .slot:hover{transform:translateY(-2px)}
  .slot b{font-size:13px}.slot span{font-size:11.5px;opacity:.95}.slot i{font-style:normal;font-size:10.5px;opacity:.8}
