const predikat = (n, kkm) => n >= 90 ? 'A' : n >= Math.max(kkm, 80) ? 'B' : n >= kkm ? 'C' : 'D';
function nilaiAkhir(avg) {
  const ws = JENIS.map(j => Number(D.sekolah[BOBOT_KEY[j]]) || 0), allZero = ws.every(w => !w);
  let sw = 0, sum = 0;
  JENIS.forEach((j, i) => { if (avg[j] == null) return; const w = allZero ? 1 : ws[i]; sw += w; sum += avg[j] * w; });
  return sw ? sum / sw : null;
}
