        body = `<div class="card"><div class="toolbar"><button class="btn pri" data-act="edit" data-t="pengguna">${ic('plus', 16)} Tambah Akun Guru</button></div>${S._peng.length ? `<div class="tbl-wrap"><table class="tbl"><thead><tr><th>Username</th><th>Nama</th><th>NIP</th><th class="c">Pengampu</th><th>Status</th><th></th></tr></thead><tbody>${S._peng.map(p => { const ps = D.penugasan.filter(x => x.guru_id === p.id); return `<tr><td><b>${esc(p.username)}</b></td><td>${esc(p.nama || '-')}</td><td class="muted">${esc(p.nip || '-')}</td><td class="c"><span class="badge b-vio">${new Set(ps.map(x => x.mapel_id)).size} mapel • ${ps.length} kelas</span></td><td><button class="badge ${p.aktif === false ? 'b-bad' : 'b-ok'}" data-act="pengAktif" data-id="${p.id}">${p.aktif === false ? 'Nonaktif' : 'Aktif'}</button></td><td class="r"><button class="ib" data-act="edit" data-t="pengguna" data-id="${p.id}">${ic('edit', 16)}</button><button class="ib bad" data-act="del" data-t="pengguna" data-id="${p.id}" data-rl="guru,penugasan,siswa" data-msg="Hapus akun ${esc(p.username)}? Penugasan mapel guru ini ikut dihapus (jurnal, absensi, nilai tetap tersimpan).">${ic('trash', 16)}</button></td></tr>`; }).join('')}</tbody></table></div>` : empty('user', 'Belum ada akun guru', 'Tambahkan akun guru, lalu tetapkan mapel & kelasnya di menu Mata Pelajaran.')}
        <div class="note">Anda masuk sebagai <b>Admin</b> (${esc(S.user.email || '')}). Password admin dikelola di Supabase → Authentication → Users. Mapel & kelas tiap guru diatur di menu <b>Mata Pelajaran</b>.</div></div>`;
      } else body = `<div class="card" style="max-width:460px;margin-bottom:14px"><h3 style="color:var(--ink);margin-bottom:10px">Profil Saya</h3><div class="irow" style="margin-bottom:8px">${bub('user', 'g-vio')}<div><small>Nama</small><b>${esc(S.user.nama || '-')}</b></div></div><div class="irow" style="margin-bottom:8px">${bub('file', 'g-blue')}<div><small>Username • NIP</small><b>${esc(S.user.username || '-')} • ${esc(S.user.nip || '-')}</b></div></div><p class="muted">Nama dan NIP ini tampil pada tanda tangan laporan cetak. Perubahan data diminta ke Admin.</p></div>
      <div class="card" style="max-width:460px"><h3 style="color:var(--ink);margin-bottom:12px">Ganti Password</h3><form data-form="gantiPw" style="display:flex;flex-direction:column;gap:12px"><div class="fld"><label>Password lama</label><input name="lama" type="password" required autocomplete="current-password"></div><div class="fld"><label>Password baru</label><input name="baru" type="password" required minlength="6" autocomplete="new-password"></div><div class="fld"><label>Ulangi password baru</label><input name="ulang" type="password" required autocomplete="new-password"></div><button class="btn pri" type="submit">Simpan Password</button></form></div>`;
    } else body = `<div class="card" style="max-width:560px"><h3 style="color:var(--ink);margin-bottom:6px">Cadangan Data</h3><p style="margin-bottom:14px">Unduh ${adm ? 'seluruh data' : 'data Anda'} (kelas, siswa, jadwal, jurnal, absensi, nilai, bimbingan) sebagai file JSON.</p><button class="btn pri" data-act="backup">${ic('dl', 16)} Unduh Cadangan</button>
      <div class="note"><b>Mode:</b> ${IS_PREVIEW ? 'Preview (data uji di memori browser — tidak tersimpan)' : 'Terhubung ke Supabase'}<br><b>Peran:</b> ${adm ? 'Admin' : 'Guru'}</div></div>`;
    return `${phead('Pengaturan', adm ? 'Sekolah & aplikasi' : 'Akun & informasi sekolah')}<div class="tabs">${tabs.map(([id, l]) => `<button class="tab ${t === id ? 'on' : ''}" data-act="tab" data-p="pg.tab" data-v="${id}">${l}</button>`).join('')}</div>${body}`;
  },
  after() { if (S.role !== 'admin') $$('form[data-ro] input,form[data-ro] select,form[data-ro] textarea').forEach(e => { e.disabled = true; }); }
};

/* ================================= MULAI ================================= */
(async function init() {
  try { document.body.style.overflow = 'hidden'; } catch (e) { /* abaikan */ }
  setupPWA();
  if (sbError) { root.innerHTML = `<div class="login"><div class="lcard"><h2>Tidak dapat memuat Supabase</h2><p class="sub">${esc(sbError.message || sbError)}</p><p class="sub">Periksa koneksi internet lalu muat ulang halaman.</p></div></div>`; return; }
  if (!IS_PREVIEW && (SUPABASE_URL.startsWith('URL_') || SUPABASE_ANON_KEY.startsWith('ANON_'))) {
    root.innerHTML = `<div class="login"><div class="lcard"><h2>Supabase belum dikonfigurasi</h2><p class="sub">Isi SUPABASE_URL dan SUPABASE_ANON_KEY di bagian atas skrip, atau kembalikan IS_PREVIEW = true.</p></div></div>`; return;
  }
  await autoSetupDatabase();
  if (await bootAuth()) await enterApp(); else renderLogin();
})();
</script>
</body>
</html>
